VITE_API_BASE_URL=https://equal-street-angelfish.ngrok-free.dev
# Live auth + UC8 family create/me by default. Set true only for unfinished
# family/admin mock surfaces (members, history, admin pages).
VITE_USE_MOCK_API=false
# Hosted builds only: GitHub Actions secret FIREBASE_APP_DISTRIBUTION_URL is
# passed as VITE_FIREBASE_APP_DISTRIBUTION_URL. Do not put the URL in this file.
# Local /me falls back to https://appdistribution.firebase.google.com/

# Invite emails use backend CANMAKAN_INVITES_PUBLIC_BASE_URL (web invite) and
# FIREBASE_APP_DISTRIBUTION_URL (mobile install link — same secret as this web banner).
# (local web default http://localhost:5173; deploy https://canmakan-project.web.app).
# CORS already allows Vite localhost/127.0.0.1 and both Firebase Hosting origins.
# Backend must allow this page origin. Local Vite :5173/:5174 are in the backend
# default allow-list; for deploy set CANMAKAN_CORS_ALLOWED_ORIGINS on the server
# to your public web origin(s).
