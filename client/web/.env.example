VITE_API_BASE_URL=http://localhost:8080
# Live auth + UC8 family create/me by default. Set true only for unfinished
# family/admin mock surfaces (members, history, admin pages).
VITE_USE_MOCK_API=false
# Backend must allow this page origin. Local Vite :5173 is in the backend default
# allow-list; for deploy set CANMAKAN_CORS_ALLOWED_ORIGINS on the server to your
# public web origin(s).
