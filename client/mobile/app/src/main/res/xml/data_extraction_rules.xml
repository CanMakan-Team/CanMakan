<?xml version="1.0" encoding="utf-8"?>
<!-- res/xml/data_extraction_rules.xml -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Prevent shared preferences (including encrypted prefs) from being backed up -->
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Prevent shared preferences (including encrypted prefs) from being transferred to a new device -->
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>