## Example local overrides (copy values into untracked local.properties)
#
# SDK path is usually written by Android Studio:
# sdk.dir=C\:\\Users\\you\\AppData\\Local\\Android\\Sdk
#
# Emulator default (also BuildConfig default): host loopback via 10.0.2.2
# BASE_URL=http://10.0.2.2:8080/api/
#
# Physical device on same Wi-Fi — use your PC's LAN IP (backend binds 0.0.0.0:8080):
# BASE_URL=http://192.168.1.50:8080/api/
#
# Public web origin(s) for invite App Links — same name as backend
# CANMAKAN_INVITES_PUBLIC_BASE_URL. Comma-separated aliases are allowed so the
# app can claim both Firebase Hosting hosts. Debug default includes local Vite
# plus Firebase Hosting. Override to localhost-only while testing:
# CANMAKAN_INVITES_PUBLIC_BASE_URL=http://localhost:5173,http://127.0.0.1:5173
# Production / CI:
# CANMAKAN_INVITES_PUBLIC_BASE_URL=https://canmakan-project.web.app,https://canmakan-project.firebaseapp.com
#
# Firebase App Distribution install links are backend/web shared
# (FIREBASE_APP_DISTRIBUTION_URL) for invite emails and the /me banner — not set here.
#
# Backend CORS allows private LAN browser origins; native Retrofit does not need CORS.
